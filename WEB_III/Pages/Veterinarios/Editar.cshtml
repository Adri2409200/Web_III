@page "{id:int}"
@model WEB_III.Pages.Veterinarios.EditarModel
@{
    ViewData["Title"] = "Editar veterinario";
}

<h1 class="page-title">✏️ Editar veterinario</h1>

<div class="card-aa p-4" style="max-width:600px;">
    <form method="post">
        <input type="hidden" asp-for="Veterinario.Id" />

        <div class="row g-3">

            <div class="col-sm-6">
                <label asp-for="Veterinario.Nombre" class="form-label">Nombre</label>
                <input asp-for="Veterinario.Nombre" class="form-control" />
                <span asp-validation-for="Veterinario.Nombre" class="text-danger small"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="Veterinario.Apellido" class="form-label">Apellido</label>
                <input asp-for="Veterinario.Apellido" class="form-control" />
                <span asp-validation-for="Veterinario.Apellido" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Veterinario.Especialidad" class="form-label">Especialidad</label>
                <input asp-for="Veterinario.Especialidad" class="form-control" />
                <span asp-validation-for="Veterinario.Especialidad" class="text-danger small"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="Veterinario.Telefono" class="form-label">Teléfono</label>
                <input asp-for="Veterinario.Telefono" class="form-control" />
                <span asp-validation-for="Veterinario.Telefono" class="text-danger small"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="Veterinario.Estado" class="form-label">Estado</label>
                <select asp-for="Veterinario.Estado"
                        asp-items="Html.GetEnumSelectList<WEB_III.Models.Enums.EstadoPersona>()"
                        class="form-select"></select>
            </div>

        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-aa-primary">💾 Guardar cambios</button>
            <a asp-page="Index" class="btn btn-aa-secondary">✕ Cancelar</a>
        </div>

    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
