@* Partial view: modal de confirmación de eliminación reutilizable.
   Requiere que la página incluya un formulario con id="formEliminar"
   y un campo hidden "id" que se llena por JS antes de submit. *@

<div class="modal fade" id="modalEliminar" tabindex="-1"
     aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">

            <div class="modal-header card-header-rose">
                <h5 class="modal-title" id="modalEliminarLabel">
                    🗑️ Confirmar eliminación
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <p class="mb-0">
                    ¿Estás seguro de que deseas eliminar este registro?
                    <br />
                    <small class="text-muted">Esta acción no se puede deshacer.</small>
                </p>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-aa-secondary"
                        data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-aa-danger"
                        id="btnConfirmarEliminar">Eliminar</button>
            </div>

        </div>
    </div>
</div>
