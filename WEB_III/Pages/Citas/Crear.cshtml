@page
@model WEB_III.Pages.Citas.CrearModel
@{
    ViewData["Title"] = "Nueva cita";
}

<h1 class="page-title">➕ Nueva cita</h1>

<div class="card-aa p-4" style="max-width:680px;">
    <form method="post">

        <div class="row g-3">

            <div class="col-sm-6">
                <label asp-for="Cita.MascotaId" class="form-label">Mascota</label>
                <select asp-for="Cita.MascotaId"
                        asp-items="Model.MascotasSelect"
                        class="form-select">
                    <option value="">— Seleccionar mascota —</option>
                </select>
                <span asp-validation-for="Cita.MascotaId" class="text-danger small"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="Cita.VeterinarioId" class="form-label">Veterinario</label>
                <select asp-for="Cita.VeterinarioId"
                        asp-items="Model.VeterinariosSelect"
                        class="form-select">
                    <option value="">— Seleccionar veterinario —</option>
                </select>
                <span asp-validation-for="Cita.VeterinarioId" class="text-danger small"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="Cita.FechaHoraAtencion" class="form-label">Fecha y hora de atención</label>
                <input asp-for="Cita.FechaHoraAtencion" type="datetime-local" class="form-control" />
                <span asp-validation-for="Cita.FechaHoraAtencion" class="text-danger small"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="Cita.Estado" class="form-label">Estado</label>
                <select asp-for="Cita.Estado"
                        asp-items="Html.GetEnumSelectList<WEB_III.Models.Enums.EstadoCita>()"
                        class="form-select"></select>
            </div>

            <div class="col-12">
                <label asp-for="Cita.Motivo" class="form-label">Motivo de la consulta</label>
                <textarea asp-for="Cita.Motivo" class="form-control" rows="3"
                          placeholder="Describe el motivo de la visita…"></textarea>
                <span asp-validation-for="Cita.Motivo" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Cita.Diagnostico" class="form-label">
                    Diagnóstico <small class="text-muted">(opcional)</small>
                </label>
                <textarea asp-for="Cita.Diagnostico" class="form-control" rows="3"
                          placeholder="Diagnóstico del veterinario…"></textarea>
                <span asp-validation-for="Cita.Diagnostico" class="text-danger small"></span>
            </div>

        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-aa-primary">💾 Agendar cita</button>
            <a asp-page="Index" class="btn btn-aa-secondary">✕ Cancelar</a>
        </div>

    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
